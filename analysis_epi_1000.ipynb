                last_id1 = id1
            s2 = match.load_bed(f_map[id2])
            overlap = match.pair_overlap(s1, s2)
            # Update cache to include overlap
            cache_pw_15[key] = {'metrics': metrics, 'overlap': overlap}
            updated_pw_15 = True
            
